    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^10.5.1",
    "fake-indexeddb": "^6.2.4",
    "jsdom": "^27.2.0",
    "pngjs": "^7.0.0",
